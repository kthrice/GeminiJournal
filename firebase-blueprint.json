{
  "entities": {
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "Authenticated user journal entries with multi-turn conversations and Reflection Compass synthesis.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firestore-generated unique document identifier."
        },
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase user UID matching request.auth.uid."
        },
        "title": {
          "type": "string",
          "maxLength": 300,
          "description": "Title of the reflective journal entry."
        },
        "messages": {
          "type": "array",
          "description": "Chronological multi-turn dialogue between user and Gemini."
        },
        "summary": {
          "type": "string",
          "maxLength": 5000,
          "description": "Reflection Compass 2-3 sentence core summary."
        },
        "themes": {
          "type": "array",
          "description": "Reflection Compass 3 key thematic topics."
        },
        "mood": {
          "type": "string",
          "maxLength": 80,
          "description": "Assessed emotional/mindset state."
        },
        "moodConfidence": {
          "type": "number",
          "description": "Calibrated confidence level score (0.0 to 1.0)."
        },
        "nextStep": {
          "type": "string",
          "maxLength": 1000,
          "description": "Actionable micro-step identified by Gemini."
        },
        "reflectionQuestion": {
          "type": "string",
          "maxLength": 1000,
          "description": "Introspective contemplation prompt."
        },
        "createdAt": {
          "type": "number",
          "description": "Millisecond epoch timestamp when entry was logged."
        },
        "updatedAt": {
          "type": "number",
          "description": "Millisecond epoch timestamp when entry was last modified."
        }
      },
      "required": [
        "userId",
        "title",
        "messages",
        "summary",
        "themes",
        "mood",
        "moodConfidence",
        "nextStep",
        "reflectionQuestion",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/journalEntries/{entryId}": {
      "schema": "JournalEntry",
      "description": "Isolated per-user collection storing private journal entries and Reflection Compass records."
    }
  }
}
